APP_BASE_URL=https://shuttleup.example
APP_TIMEZONE=Asia/Shanghai
APP_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:////data/shuttleup.db
SESSION_COOKIE_SECURE=true
ASTRBOT_MAIN_TOKEN=replace-with-a-random-service-token
LOG_LEVEL=INFO
DEMO_MODE=false
APP_PORT=8000
# 使用 compose.https.yaml 时填写纯域名（无协议）和证书通知邮箱。
# SITE_DOMAIN=shuttleup.example.com
# ACME_EMAIL=owner@example.com
# 使用已有反向代理时，填写其到容器的实际来源 IP。
# FORWARDED_ALLOW_IPS=172.17.0.1
# 默认内置 WakeUp 分享协议；仅使用自建标准化适配服务时填写下面一项。
# WAKEUP_SHARE_ENDPOINT=https://approved-adapter.example/import

# 邮箱注册：QQ 邮箱示例。SMTP_PASSWORD 填授权码，不是邮箱登录密码。
# 将配置放入本机 .env（已被 Git 忽略），修改后重启后端。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_FROM=
SMTP_PASSWORD=

# 指定管理员邮箱：仅在该邮箱通过验证码完成注册后授予权限。
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
